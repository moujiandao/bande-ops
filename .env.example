# Copy this file to .env.local (gitignored) and fill in real values.
# Never commit real secrets — .env.local stays local / in your deployment provider's secret store.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # Supabase project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                 # Supabase anon/public key (RLS-gated, browser-safe)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key             # Supabase service-role key (server-only, bypasses RLS — never expose)

# --- Amazon Login With Amazon (LWA) / SP-API ---
LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx         # LWA client ID for the SP-API app (server-only)
LWA_CLIENT_SECRET=your-lwa-client-secret                    # LWA client secret (server-only — never expose)
SPAPI_REFRESH_TOKEN=Atzr|your-refresh-token                 # SP-API refresh token used to mint access tokens (server-only)
SPAPI_SELLER_ID=your-merchant-token                         # Seller/merchant token; REQUIRED in live mode (catalog SKU lookups are seller-scoped)

# --- SV Direct (SVD) replenishment supplier ---
# Server-only. Used by the owner-gated "Refresh SVD" button on /reorder.
SVD_BASE_URL=https://svdirect.us                            # Optional; defaults to https://svdirect.us
SVD_USERNAME=your-svd-login                                 # SVD portal login (server-only — never expose)
SVD_PASSWORD=your-svd-password                              # SVD portal password (server-only — never expose)

# --- Amazon client mode ---
AMAZON_USE_SANDBOX=true                                     # Hit the SP-API sandbox instead of production (default true)
AMAZON_USE_FAKE=false                                       # Use the in-process fake Amazon client, no network calls (default false)
